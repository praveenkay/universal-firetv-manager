{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Fire TV Manager",
  "version": "0.1.0",
  "identifier": "dev.universal-firetv.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Universal Fire TV Manager", "width": 1100, "height": 780, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Utility",
    "shortDescription": "Safe Fire TV backup, launcher setup, and restore",
    "longDescription": "Backup-first Fire TV launcher setup, conservative debloat, health checks, uninstall, and restore."
  }
}
